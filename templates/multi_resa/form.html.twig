{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/poste.css') }}">
{% endblock %}

{% block javascripts %}
    <script>
document.addEventListener('DOMContentLoaded', function() {
    const selects = document.querySelectorAll('.large-font-select');
    selects.forEach(select => {
        // Augmenter la taille de la police pour le select
        select.style.fontSize = '1.2rem';
        
        // Pour les navigateurs qui supportent ::part()
        select.setAttribute('style', '--select-font-size: 1.4rem');
    });
});
</script>
{% endblock %}

{% block body %}
    <h1 class="titre">Réserver tous les postes</h1>

    {% if errorMessage is not empty %}
        <div class="alert">{{ errorMessage }}</div>
    {% endif %}

    {{ form_start(form, {'attr': {'class': 'form'}}) }}
        {{ form_errors(form) }}
        <div>
            {{ form_label(form.start, 'Date d\'arrivée :', {'attr': {'class': 'formStart'}}) }}
        </div>
        <div>
            {{ form_widget(form.start, {'attr': {'class': 'formStart'}}) }}
        </div>
        <div>
            {{ form_label(form.end, 'Date de départ :', {'attr': {'class': 'formEnd'}}) }}
        </div>
        <div>
            {{ form_widget(form.end, {'attr': {'class': 'formEnd'}}) }}
        </div>
        <div class="hrFormGrid">
            <hr class="hrForm">
        </div>
        <div>
            {{ form_label(form.email, 'Email :', {'attr': {'class': 'formEmail'}}) }}
        </div>
        <div>
            {{ form_widget(form.email, {'attr': {'class': 'formEmail'}}) }}
            {{ form_errors(form.email) }}
        </div>
        <div>
            {{ form_label(form.phoneNumber, 'Numéro de téléphone :', {'attr': {'class': 'formPhone'}}) }}
        </div>
        <div>
            {{ form_widget(form.phoneNumber, {'attr': {'class': 'formPhone'}}) }}
            {{ form_errors(form.phoneNumber) }}
        </div>
        <div class="hrFormGrid">
            <hr class="hrForm">
            <p class="hrText">Avez-vous pensé à l'amorçage?</p>
        </div>
        <div>
            {{ form_label(form.pellets45, 'Pellets 45% Protéines') }}
        </div>
        <div>
            {{ form_widget(form.pellets45, {'attr': {'class': 'numberFormPellet'}}) }}
        </div>
        <div>
            {{ form_label(form.pellets35, 'Pellets 35% Protéines') }}
        </div>
        <div>
            {{ form_widget(form.pellets35, {'attr': {'class': 'numberFormPellet'}}) }}
        </div>
        <button type="submit" class="btnAction">{{ button_label|default('Combien ça coûte?') }}</button>
    {{ form_end(form) }}

    <hr class="hr">
    <a href="{{ path('app_reservation') }}" class="btnAction">Retour</a>
{% endblock %}
