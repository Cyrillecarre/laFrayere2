{% extends 'base.html.twig' %}

{% block title %}New PosteThree{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/poste.css') }}">
{% endblock %}

{% block javascripts %}
    <script>
document.addEventListener('DOMContentLoaded', function() {
    const selects = document.querySelectorAll('.large-font-select');
    selects.forEach(select => {
        // Augmenter la taille de la police pour le select
        select.style.fontSize = '1.2rem';
        
        // Pour les navigateurs qui supportent ::part()
        select.setAttribute('style', '--select-font-size: 1.4rem');
    });

    const form = document.querySelector('form');
    if (!form) return;

    const fishersSelect = form.querySelector('select[name$="[numberOfFishers]"]');
    const startDateInput = form.querySelector('input[name$="[start][date]"]');
    const endDateInput = form.querySelector('input[name$="[end][date]"]');
    const startTimeInput = form.querySelector('input[name$="[start][time]"]');
    const endTimeInput = form.querySelector('input[name$="[end][time]"]');

    if (!fishersSelect || !startDateInput || !endDateInput) return;

    const dateError = document.createElement('div');
    dateError.style.color = 'red';
    dateError.style.marginTop = '0.25rem';
    endDateInput.parentNode.insertBefore(dateError, endDateInput.nextSibling);

    const dayNumber = (dateStr) => {
        if (!dateStr) return null;
        const d = new Date(dateStr + 'T00:00:00');
        if (Number.isNaN(d.getTime())) return null;
        const jsDay = d.getDay();
        return jsDay === 0 ? 7 : jsDay;
    };

    const updateFishers = () => {
        const startDow = dayNumber(startDateInput.value);
        const endDow = dayNumber(endDateInput.value);
        const canSelectOne = startDow !== null && endDow !== null && (startDow >= 1 && startDow <= 4) && (endDow >= 2 && endDow <= 5);

        const optionOne = Array.from(fishersSelect.options).find(o => String(o.value) === '1');
        if (!optionOne) return;

        optionOne.disabled = !canSelectOne;
        if (optionOne.disabled && fishersSelect.value === '1') {
            fishersSelect.value = '2';
        }
    };

    startDateInput.addEventListener('change', updateFishers);
    endDateInput.addEventListener('change', updateFishers);
    updateFishers();

    const parseDateTime = (dateStr, timeStr) => {
        if (!dateStr) return null;
        const t = timeStr || '00:00';
        const d = new Date(dateStr + 'T' + t);
        return Number.isNaN(d.getTime()) ? null : d;
    };

    const validateDates = () => {
        const startDt = parseDateTime(startDateInput.value, startTimeInput ? startTimeInput.value : null);
        const endDt = parseDateTime(endDateInput.value, endTimeInput ? endTimeInput.value : null);
        dateError.textContent = '';

        if (!startDt || !endDt) return;

        if (endDt.getTime() < startDt.getTime()) {
            dateError.textContent = 'date incorrecte';
            return;
        }

        const diffDays = (endDt.getTime() - startDt.getTime()) / 86400000;
        if (diffDays > 7) {
            dateError.textContent = 'durée trop longue';
        }
    };

    startDateInput.addEventListener('change', validateDates);
    endDateInput.addEventListener('change', validateDates);
    if (startTimeInput) startTimeInput.addEventListener('change', validateDates);
    if (endTimeInput) endTimeInput.addEventListener('change', validateDates);
    validateDates();
});
</script>
{% endblock %}

{% block body %}
    <hr class="hr">
    <h1 class="titre">Ajouter une réservation Poste 3</h1>

    {{ form_start(form, {'attr': {'class': 'form'}}) }}
        {{ form_errors(form) }}
        <div>
            {{ form_label(form.start, 'Date d\'arrivée :', {'attr': {'class': 'formStart'}}) }}
        </div>
        <div>
            {{ form_widget(form.start, {'attr': {'class': 'formStart'}}) }}
        </div>
        <div>
            {{ form_label(form.end, 'Date de départ :', {'attr': {'class': 'formEnd'}}) }}
        </div>
        <div>
            {{ form_widget(form.end, {'attr': {'class': 'formEnd'}}) }}
        </div>
        <div>
            {{ form_label(form.numberOfFishers, 'Nombre de pêcheurs', {'attr': {'class': 'numberForm'}}) }}
        </div>
        <div>
            {{ form_widget(form.numberOfFishers, {'attr': {'class': 'numberForm'}}) }}
        </div>
        <div class="hrFormGrid">
            <hr class="hrForm">
        </div>
        <div>
            {{ form_label(form.email, 'Email', {'attr': {'class': 'formEmail'}}) }}
        </div>
        <div>
            {{ form_widget(form.email, {'attr': {'class': 'formEmail'}}) }}
            {{ form_errors(form.email) }}
        </div>
        <div>
            {{ form_label(form.phoneNumber, 'Numéro de tel', {'attr': {'class': 'formPhone'}}) }}
        </div>
        <div>
            {{ form_widget(form.phoneNumber, {'attr': {'class': 'formPhone'}}) }}
            {{ form_errors(form.phoneNumber) }}
        </div>
        
        <div class="hrFormGrid">
            <hr class="hrForm">
            <p class="hrText">Avez-vous pensé à l'amorçage?</p>
        </div>
        <div>
            {{ form_label(form.pellets45, 'Pellets 45% Protéines') }}
        </div>
        <div>
            {{ form_widget(form.pellets45, {'attr': {'class': 'numberFormPellet'}}) }}
        </div>
        <div>
            {{ form_label(form.pellets35, 'Pellets 35% Protéines') }}
        </div>
        <div>
            {{ form_widget(form.pellets35, {'attr': {'class': 'numberFormPellet'}}) }}
        </div>
        <div class="hrFormGrid">
            <hr class="hrForm">
        </div>
        <div class="hrFormGrid">
            <p class="hrText">Code cadeau ?</p>
            {{ form_widget(form.giftCode, {'attr': {'class': 'formCode'}}) }}
        </div>
        <button class="btnAction">{{ button_label|default('Combien ça coûte?') }}</button>
    {{ form_end(form) }}

    <hr class="hr">
    <a href="{{ path('app_reservation') }}" class="btnAction">Retour</a>
{% endblock %}
